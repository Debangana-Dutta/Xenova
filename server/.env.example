# Copy this file to server/.env and fill in your own values.
# server/.env is gitignored — never commit real secrets.

# Local MongoDB, or an Atlas connection string:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/xenova
MONGO_URI=mongodb://127.0.0.1:27017/xenova

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# Origin allowed by CORS. Must match where the React dev server runs.
CLIENT_URL=http://localhost:3000

PORT=5001

# Set to "production" when deploying. This also stops the error handler
# returning stack traces in API responses.
NODE_ENV=development
